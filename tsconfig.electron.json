{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist-electron",
    "rootDir": "app",
    "types": ["node"]
  },
  "include": [
    "app/main/**/*.ts",
    "app/preload/**/*.ts",
    "app/preload/**/*.cts",
    "app/domain/**/*.ts",
    "app/adapters/**/*.ts",
    "app/rules/**/*.ts"
  ]
}
