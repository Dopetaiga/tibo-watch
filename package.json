{
  "name": "tibo-watch",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Windows assistant for monitoring public Tibo reset signals.",
  "license": "MIT",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:portable": "node scripts/verify-portable-startup.mjs",
    "test:installer": "node scripts/verify-installer-startup.mjs",
    "research:collect-leads": "node research/scripts/collect-reset-leads.mjs",
    "research:validate": "node research/scripts/validate-provisional-dataset.mjs",
    "research:enrich-timeline": "node research/scripts/enrich-timeline-capture.mjs",
    "research:apply-reviews": "node research/scripts/apply-timeline-reviews.mjs",
    "research:review-leads": "node research/scripts/review-reset-leads.mjs",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron && node scripts/verify-runtime-boundary.mjs",
    "pack:dir": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "dev.tibowatch.app",
    "productName": "Tibo Watch",
    "asar": true,
    "files": ["dist/**/*", "dist-electron/**/*", "package.json"],
    "directories": { "output": "release" },
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "${productName}-${version}-portable.${ext}" }
  }
}
